# Salin ke .env lalu isi nilainya:  cp .env.example .env
# .env di-gitignore dan dimuat otomatis oleh `go run ./cmd/server` maupun `air`.
# Variabel yang sudah disetel di shell TIDAK ditimpa oleh nilai di file ini.
# Simpan tanpa BOM (UTF-8 tanpa BOM / ASCII), kalau tidak godotenv gagal membaca.

# --- Mode -------------------------------------------------------------------
# development (default) | production
# production: cookie Secure, FACE_SERVICE_TOKEN wajib, token ping perangkat wajib.
APP_ENV=development

# --- Secret wajib (semua mode, masing-masing acak minimal 32 karakter) ------
# Contoh membuat nilai acak:  openssl rand -hex 32
CSRF_SECRET=
DEVICE_TOKEN=

# --- Akun staf awal (hanya dibaca saat belum ada administrator aktif) --------
# Hapus/kosongkan setelah akun terbentuk.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Opsional: akun dosen (dibuat bila username belum ada)
# BOOTSTRAP_LECTURER_USERNAME=
# BOOTSTRAP_LECTURER_PASSWORD=
# BOOTSTRAP_LECTURER_CLASSES=IK24-A,IK24-B

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://10.100.1.11:27017
MONGODB_DATABASE=attendance

# --- Face service (Python, internal) ----------------------------------------
# services/face/api.py (uvicorn api:app --host 127.0.0.1 --port 8000)
FACE_SERVICE_URL=http://127.0.0.1:8000
# Ambang cosine similarity ArcFace (samakan dengan SIM_THRESHOLD di face service).
FACE_SIM_THRESHOLD=0.45
# Batas waktu satu panggilan /detect ke face service (detik).
FACE_SERVICE_TIMEOUT_SECONDS=15
# Dikirim sebagai Bearer token; wajib >= 32 karakter bila APP_ENV=production.
# Catatan: api.py belum memeriksa token ini, jadi jalankan face service di jaringan internal.
FACE_SERVICE_TOKEN=

# --- Penyimpanan foto wajah (S3: Garage) -------------------------------------
# Opsional. Kosongkan semua S3_* untuk menonaktifkan (foto tidak disimpan).
# Buat kunci khusus bucket di server Garage:
#   garage bucket create methics-faces
#   garage key create methics-app
#   garage bucket allow --read --write methics-faces --key methics-app
S3_ENDPOINT=http://10.100.1.11:3900
S3_REGION=garage
S3_BUCKET=methics-faces
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Masa simpan foto scan (hari): Hadir / (Perlu ditinjau + Ditolak). 0 = tanpa batas.
IMAGE_RETENTION_DAYS=30
IMAGE_REVIEW_RETENTION_DAYS=90

# --- Opsional ---------------------------------------------------------------
# HTTP_ADDR=:8080
# STATIC_DIR=static
# VIEW_DIR=views
